# ---- Which service(s) this process runs ---------------------------------------
# CamelCase, comma-separated: IdentityService, PublishingApi, ConnectorService, SchedulerWorker,
# Gateway, or All (default). `inkcast services` lists them.
# INKCAST_APP_NAME=All
# Serve at "/" (default), under /<full-name> ("auto", e.g. /publishing-api), or under a path.
# INKCAST_PATH_PREFIX=/
# Gateway only: where each service is. The value may include the service's prefix.
# INKCAST_UPSTREAM_IDENTITY_SERVICE=http://localhost:8001/identity-service
# INKCAST_UPSTREAM_PUBLISHING_API=http://localhost:8002/publishing-api
# INKCAST_UPSTREAM_CONNECTOR_SERVICE=http://localhost:8003/connector-service
# Seconds between scheduler ticks (1-60): each tick claims and sends the posts due. 120 s or more would fail the
# on-time KPI by design.
# INKCAST_SCHEDULER_INTERVAL=20
# Seconds past due before a scheduled post counts as overdue (metric inkcast_posts_overdue, the critical
# InkcastPostsOverdue alert): at least twice INKCAST_SCHEDULER_INTERVAL, or posts due between two ticks count as overdue,
# and at most 3600: beyond an hour the alert, the only signal that the scheduler is behind or stopped, stays quiet that long.
# INKCAST_OVERDUE_GRACE=600
# Seconds between InsightsService passes that fold new events into KPI rollups (1 or more).
# INKCAST_INSIGHTS_INTERVAL=10
# Seconds a stopping process gives in-flight requests and sends to finish: more than 0 and under 40, the Deployment's
# terminationGracePeriodSeconds, at which point Kubernetes kills the pod whatever is in flight.
# INKCAST_SHUTDOWN_GRACE=25
# Retries for a scheduled post whose send certainly never happened (connection failure, 429): sends in all (1-10),
# and the seconds between them (1-9 values, each 30-21600, never decreasing; the last one repeats). A send that may
# have gone out is never retried, whatever these say. A window over 24 h is a posture warning.
# INKCAST_PUBLISH_MAX_ATTEMPTS=4
# INKCAST_PUBLISH_RETRY_DELAYS=60,300,1800
# Daily backups kept (`inkcast backup --keep`, the backup CronJob), 1 or more; the deletion pages tell a person that
# copies of their data in backups age out within this many days. Keep it equal to the CronJob's value. Above 35 is a
# posture warning: a deleted person's data would linger over five weeks.
# INKCAST_BACKUP_KEEP=14
# Retention: days a domain event is kept in the outbox, counted from when it was written (the replay window, 1-30;
# purged once that old and every consumer has passed it), and days hourly KPI buckets and their kpi_applied rows are
# kept (31-400; hourly series serve up to 31 days). The hourly retention may never be shorter than the outbox's:
# kpi_applied is what stops a replayed event counting twice.
# Daily buckets are kept indefinitely.
# INKCAST_OUTBOX_RETENTION_DAYS=7
# INKCAST_KPI_HOURLY_RETENTION_DAYS=90

# ---- Server ------------------------------------------------------------------
# MCP endpoint is $INKCAST_PUBLIC_URL/mcp
INKCAST_PUBLIC_URL=https://inkcast.example.com
# Writes per minute per client address on the endpoints anyone can call without a token (0-10000). 0 turns the
# limit off, which with INKCAST_LOGIN=password is unlimited password guessing: a posture failure in production;
# above 600 (ten a second) with password sign-in no longer slows a guessing tool: a posture warning.
# INKCAST_RATE_LIMIT_PER_MINUTE=60
# At least 32 chars: python -c 'import secrets;print(secrets.token_urlsafe(48))'
INKCAST_SECRET_KEY=
INKCAST_DATABASE=/data/inkcast.db
# Extra Host headers to accept behind a proxy (comma separated)
# INKCAST_ALLOWED_HOSTS=inkcast.internal:8787

# ---- Token lifetimes ------------------------------------------------------------
# Personal access tokens: the days when a request doesn't say (1 to the maximum), the most a request may ask for
# (1-366), and whether one may never expire (REST null, /tokens/new?days=never). Every entry point refuses more
# with a 422 naming the limit; lowering the maximum doesn't shorten tokens already issued.
# INKCAST_PAT_DEFAULT_DAYS=90
# INKCAST_PAT_MAX_DAYS=366
# INKCAST_PAT_ALLOW_NO_EXPIRY=true
# Days a newly issued MCP refresh token lasts (1-90): an idle timeout, since each refresh issues a new one.
# The access token's hour is not a setting.
# INKCAST_REFRESH_TOKEN_DAYS=30
# Minutes a one-time link lasts (5-60), one value for the connect link and the account-deletion link; the replies
# state it. 60 is a hard maximum: a connect link is a bearer capability that passes through the AI transcript, and
# whoever holds it can attach their own platform account to the person's Inkcast.
# INKCAST_ONE_TIME_LINK_MINUTES=15

# ---- Sign-in: oidc | github | password -----------------------------------------
INKCAST_LOGIN=oidc

# OIDC: a Keycloak realm, or any OpenID Connect provider
OIDC_ISSUER=https://sso.example.com/realms/inkcast
OIDC_CLIENT_ID=inkcast
OIDC_CLIENT_SECRET=
# Realm role users need (read from realm_access.roles)
OIDC_REQUIRED_ROLE=inkcast-user
# OIDC_ROLE_CLAIM=realm_access.roles
# Alternative or additional restriction (verified emails only)
# OIDC_ALLOWED_EMAIL_DOMAINS=example.com
# Open sign-up, e.g. a SaaS realm with self-registration
# INKCAST_ALLOW_ANY_USER=true

# Keycloak user sync (IdentityService): the inkcast-sync service account (view-users, view-events only), so a person
# disabled or deleted in Keycloak loses their Inkcast tokens, and one who deletes their account is erased.
# INKCAST_KEYCLOAK_SYNC_CLIENT_ID=inkcast-sync
# INKCAST_KEYCLOAK_SYNC_SECRET=
# Seconds between reads of Keycloak's events (1-840; 60 or more is a posture warning: the "cut off within a minute"
# promise), and between full re-reads of every Keycloak person (from the sync interval to 1680 less it: the
# InkcastIdentitySyncPersonFailing alert looks at a 30-minute window, the reconcile runs at the first pass after it is
# due, and 120 s are kept free for its own run and Prometheus's scrape).
# INKCAST_KEYCLOAK_SYNC_INTERVAL=30
# INKCAST_KEYCLOAK_RECONCILE_INTERVAL=600
# Days a person Keycloak no longer has stays cut off before the reconcile erases their data (0 at once, off never).
# INKCAST_KEYCLOAK_ERASE_AFTER_DAYS=30
# The sync's circuit breaker: a reconcile that finds at least BREAKER_MIN people, and more than BREAKER_PERCENT of
# those it read, gone from Keycloak at once holds them all for an operator (inkcast identity confirm-deletions)
# instead of cutting everyone off: a Keycloak restored from an older backup, the wrong issuer or a disabled LDAP
# provider all answer "User not found" about people who exist. off is a posture warning in production and staging.
# INKCAST_KEYCLOAK_BREAKER=on
# INKCAST_KEYCLOAK_BREAKER_PERCENT=10
# INKCAST_KEYCLOAK_BREAKER_MIN=5

# GitHub OAuth app, for small teams without an identity provider
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_ALLOWED_ORGS=my-org
# GITHUB_ALLOWED_USERS=alice,bob
# GitHub Enterprise:
# GITHUB_URL=https://ghe.example.com
# GITHUB_API_URL=https://ghe.example.com/api/v3

# Single person, local
# INKCAST_PASSWORD=

# ---- Platform API overrides (optional) ---------------------------------------------
# Another Forem community instead of dev.to
# INKCAST_API_URL_DEVTO=https://community.example.com/api
