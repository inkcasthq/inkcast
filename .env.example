# ---- Server ------------------------------------------------------------------
# MCP endpoint is $INKCAST_PUBLIC_URL/mcp
INKCAST_PUBLIC_URL=https://inkcast.example.com
# At least 32 chars: python -c 'import secrets;print(secrets.token_urlsafe(48))'
INKCAST_SECRET_KEY=
INKCAST_DATABASE=/data/inkcast.db
# Extra Host headers to accept behind a proxy (comma separated)
# INKCAST_ALLOWED_HOSTS=inkcast.internal:8787

# ---- Sign-in: oidc | github | password -----------------------------------------
INKCAST_LOGIN=oidc

# OIDC: a Keycloak realm, or any OpenID Connect provider
OIDC_ISSUER=https://sso.example.com/realms/inkcast
OIDC_CLIENT_ID=inkcast
OIDC_CLIENT_SECRET=
# Realm role users need (read from realm_access.roles)
OIDC_REQUIRED_ROLE=inkcast-user
# OIDC_ROLE_CLAIM=realm_access.roles
# Alternative or additional restriction (verified emails only)
# OIDC_ALLOWED_EMAIL_DOMAINS=example.com
# Open sign-up, e.g. a SaaS realm with self-registration
# INKCAST_ALLOW_ANY_USER=true

# GitHub OAuth app, for small teams without an identity provider
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_ALLOWED_ORGS=my-org
# GITHUB_ALLOWED_USERS=alice,bob
# GitHub Enterprise:
# GITHUB_URL=https://ghe.example.com
# GITHUB_API_URL=https://ghe.example.com/api/v3

# Single person, local
# INKCAST_PASSWORD=

# ---- Platform API overrides (optional) ---------------------------------------------
# Another Forem community instead of dev.to
# INKCAST_API_URL_DEVTO=https://community.example.com/api
