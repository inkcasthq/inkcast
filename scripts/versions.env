# Pinned versions of the tools that make the kind cluster (E1.F1.8.S4, issue #37). One place: CI's kind job and
# scripts/dev/stack.sh both read it through scripts/kind-tools.sh; tests/test_architecture.py keeps every
# `kind create cluster` on KIND_NODE_IMAGE.
#
# Bumping kind: take the release's checksums (kind-<os>-<arch>.sha256sum in the release assets) and its default
# node image (pkg/apis/config/defaults/image.go at the tag: kindest/node:<version>@sha256:<digest>). Keep kubectl
# within one minor version of the node image's Kubernetes (its sha256: dl.k8s.io/release/<v>/bin/<os>/<arch>/kubectl.sha256).
KIND_VERSION=v0.33.0
KIND_SHA256_linux_amd64=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
KIND_SHA256_darwin_arm64=0c8c7dbe5e23594a198b786c4bc13dacc101fa6196b0cb0b23a1ca44e61f4b4f
KIND_SHA256_darwin_amd64=5a99f26f57246dc9319dd294803313197a0f34d33c525b3ea8b655db5916ece0
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
KUBECTL_VERSION=v1.37.0
KUBECTL_SHA256_linux_amd64=6129359f4e1f3848a5572ccb0b26cf28b8ca08cef38c95a765b2f64a2c961a2f

# CloudNativePG (ADR-0014), the operator behind OpenFGA's PostgreSQL (deploy/kustomize/components/openfga): the kind
# job installs this release's manifest (releases/cnpg-<version>.yaml at the tag v<version>), checked against its
# SHA-256, through scripts/dev/openfga-e2e.sh. Bumping it: read the new file over git (`git show v<version>:releases/
# cnpg-<version>.yaml | shasum -a 256`), and move the PostgreSQL image pin in cluster.yaml with it.
CNPG_VERSION=1.30.1
CNPG_MANIFEST_SHA256=37237f145d8138256ea25ae830f87759255665ff08f8d552fdd8224a5ec032fb

# The Keycloak operator (E9.F9.1.S3), behind the production Keycloak component (deploy/kustomize/components/
# keycloak-production): the kind job installs its three install files from keycloak/keycloak-k8s-resources at this
# tag (kubernetes/keycloaks.k8s.keycloak.org-v1.yml, kubernetes/keycloakrealmimports.k8s.keycloak.org-v1.yml and
# kubernetes/kubernetes.yml, the operator's own installation guide), each checked against its SHA-256, through
# scripts/dev/keycloak-production-e2e.sh. 26.6.4 is the last 26.6 release with install files (26.6.5 to 26.6.7 are
# server-only tags; the lab's RHBK is 26.6.7, and operator/src/main is identical between the two). Bumping it: read
# the three files over git (`git show <tag>:kubernetes/<file> | shasum -a 256`); the server image is the operator's
# own (RELATED_IMAGE_KEYCLOAK in kubernetes.yml), so nothing else moves.
KEYCLOAK_OPERATOR_VERSION=26.6.4
KEYCLOAK_OPERATOR_CRD_KEYCLOAKS_SHA256=846783b8de418a5b4187705d9f651af46d1740df58fa4b4348b5e10a91e1678a
KEYCLOAK_OPERATOR_CRD_REALMIMPORTS_SHA256=4b2220309a91f04e7b561fe1c3bdabe112612842d3e2658193e364721579d762
KEYCLOAK_OPERATOR_MANIFEST_SHA256=b363f8032616bb8b3c6d33fc83af32e89fa72d48c064c33aa56055f3d310a14c
