# Pinned versions of the tools that make the kind cluster (E1.F1.8.S4, issue #37). One place: CI's kind job and
# scripts/dev/stack.sh both read it through scripts/kind-tools.sh; tests/test_architecture.py keeps every
# `kind create cluster` on KIND_NODE_IMAGE.
#
# Bumping kind: take the release's checksums (kind-<os>-<arch>.sha256sum in the release assets) and its default
# node image (pkg/apis/config/defaults/image.go at the tag: kindest/node:<version>@sha256:<digest>). Keep kubectl
# within one minor version of the node image's Kubernetes (its sha256: dl.k8s.io/release/<v>/bin/<os>/<arch>/kubectl.sha256).
KIND_VERSION=v0.33.0
KIND_SHA256_linux_amd64=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
KIND_SHA256_darwin_arm64=0c8c7dbe5e23594a198b786c4bc13dacc101fa6196b0cb0b23a1ca44e61f4b4f
KIND_SHA256_darwin_amd64=5a99f26f57246dc9319dd294803313197a0f34d33c525b3ea8b655db5916ece0
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
KUBECTL_VERSION=v1.37.0
