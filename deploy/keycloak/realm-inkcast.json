{
  "realm": "inkcast",
  "displayName": "Inkcast",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "eventsEnabled": true,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "REGISTER",
    "REGISTER_ERROR",
    "LOGOUT",
    "UPDATE_PASSWORD",
    "VERIFY_EMAIL",
    "DELETE_ACCOUNT"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "eventsExpiration": 604800,
  "roles": {
    "realm": [
      {
        "name": "inkcast-user",
        "description": "May use Inkcast. Given to every account by default."
      },
      {
        "name": "inkcast-admin",
        "description": "Inkcast operators: the admin portal (E6). Requires OTP or WebAuthn (E9.F9.4)."
      },
      {
        "name": "default-roles-inkcast",
        "description": "Roles every new account gets: inkcast-user, and the account client's delete-account (E9.F9.5.S4: a person may delete their own account).",
        "composite": true,
        "composites": {
          "realm": [
            "inkcast-user"
          ],
          "client": {
            "account": [
              "delete-account"
            ]
          }
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-inkcast"
  },
  "clients": [
    {
      "clientId": "inkcast-identity",
      "name": "Inkcast sign-in (MCP clients, the API, personal access tokens)",
      "description": "Confidential client for Inkcast's IdentityService. Secret from KC_INKCAST_CLIENT_SECRET, never in Git.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_INKCAST_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "${INKCAST_PUBLIC_URL}/auth/callback"
      ],
      "baseUrl": "${INKCAST_PUBLIC_URL}/account/return",
      "webOrigins": [
        "${INKCAST_PUBLIC_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${INKCAST_PUBLIC_URL}/"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    },
    {
      "clientId": "inkcast-sync",
      "name": "Inkcast user sync (service account)",
      "description": "Confidential, service account only: Inkcast's IdentityService reads users and admin events to cut off people disabled or deleted here (E9.F9.5.S2). Secret from KC_INKCAST_SYNC_SECRET, never in Git.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_INKCAST_SYNC_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "access.token.lifespan": "300"
      }
    }
  ],
  "users": [
    {
      "username": "service-account-inkcast-sync",
      "enabled": true,
      "serviceAccountClientId": "inkcast-sync",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "view-events"
        ]
      }
    }
  ],
  "requiredActions": [
    {
      "alias": "TERMS_AND_CONDITIONS",
      "name": "Terms and Conditions",
      "providerId": "TERMS_AND_CONDITIONS",
      "enabled": true,
      "defaultAction": true,
      "priority": 10,
      "config": {}
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 20,
      "config": {}
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30,
      "config": {}
    },
    {
      "alias": "UPDATE_PROFILE",
      "name": "Update Profile",
      "providerId": "UPDATE_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 40,
      "config": {}
    },
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 50,
      "config": {}
    },
    {
      "alias": "webauthn-register",
      "name": "Webauthn Register",
      "providerId": "webauthn-register",
      "enabled": true,
      "defaultAction": false,
      "priority": 60,
      "config": {}
    },
    {
      "alias": "delete_account",
      "name": "Delete Account",
      "providerId": "delete_account",
      "enabled": true,
      "defaultAction": false,
      "priority": 70,
      "config": {}
    }
  ],
  "smtpServer": {
    "host": "${KC_SMTP_HOST}",
    "port": "${KC_SMTP_PORT}",
    "from": "${KC_SMTP_FROM}",
    "fromDisplayName": "Inkcast",
    "auth": "${KC_SMTP_AUTH}",
    "user": "${KC_SMTP_USER}",
    "password": "${KC_SMTP_PASSWORD}",
    "starttls": "${KC_SMTP_STARTTLS}",
    "ssl": "${KC_SMTP_SSL}"
  },
  "attributes": {
    "adminEventsExpiration": "604800"
  }
}
