{
  "uid": "inkcast-platform",
  "title": "Inkcast \u00b7 platform health",
  "tags": [
    "inkcast"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus"
        },
        "query": "label_values(inkcast_build_info, namespace)",
        "refresh": 2,
        "current": {
          "text": "inkcast",
          "value": "inkcast"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Is Inkcast up?",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Pods scraped",
      "description": "up for every Inkcast target in the namespace (last value): how many answer. Green from 1; red at 0, when none does (InkcastTargetDown pages). Grey 'No data' means nothing is scraped at all: check the ServiceMonitor.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{namespace=\"$namespace\", job=~\".*inkcast.*\"})",
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#bab0ac",
                "value": null
              },
              {
                "color": "#e15759",
                "value": 0
              },
              {
                "color": "#59a14f",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "table",
      "title": "Version and plug-ins",
      "description": "inkcast_build_info: the version and the platform plug-ins each pod runs (facts, so a table). Every row should match after a rollout.",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pod, version, platforms) (inkcast_build_info{namespace=\"$namespace\"})",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "pod": 0,
              "version": 1,
              "platforms": 2
            },
            "renameByName": {
              "pod": "Pod",
              "version": "Version",
              "platforms": "Plug-ins"
            }
          }
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "row",
      "title": "Is the queue moving?",
      "collapsed": false,
      "panels": [],
      "id": 4,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Posts due and overdue (count)",
      "description": "inkcast_posts_due (blue): scheduled posts due now. inkcast_posts_overdue (red, dashed): due for longer than INKCAST_OVERDUE_GRACE. Gauges, as they are. Normal: due near 0 between ticks, overdue at 0. Overdue above 0 pages (InkcastPostsOverdue).",
      "targets": [
        {
          "refId": "A",
          "expr": "max(inkcast_posts_due{namespace=\"$namespace\"})",
          "legendFormat": "due",
          "range": true
        },
        {
          "refId": "B",
          "expr": "max(inkcast_posts_overdue{namespace=\"$namespace\"})",
          "legendFormat": "overdue",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#4e79a7"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 10
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#e15759"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 10
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      }
    },
    {
      "type": "timeseries",
      "title": "Scheduler ticks (per second)",
      "description": "rate(inkcast_scheduler_ticks_total[5m]): completed ticks. Normal: 1/20 = 0.05 per second with the default interval. Zero for 10 minutes pages (InkcastSchedulerStalled).",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(inkcast_scheduler_ticks_total{namespace=\"$namespace\"}[5m]))",
          "legendFormat": "ticks",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#4e79a7"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 10
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      }
    },
    {
      "type": "timeseries",
      "title": "Schedule lag p95 (seconds)",
      "description": "histogram_quantile(0.95, inkcast_publish_lag_seconds) over [5m], by platform: how late scheduled posts were claimed. Normal: under 20 s (one tick). The SLO allows 120 s. Empty: nothing was due in the window.",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(inkcast_publish_lag_seconds_bucket{namespace=\"$namespace\", platform=\"medium\"}[5m])))",
          "legendFormat": "medium",
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(inkcast_publish_lag_seconds_bucket{namespace=\"$namespace\", platform=\"devto\"}[5m])))",
          "legendFormat": "devto",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#4e79a7"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 10
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#e15759"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 10
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      }
    },
    {
      "type": "timeseries",
      "title": "Oldest due post age (seconds)",
      "description": "inkcast_posts_oldest_due_age_seconds: head-of-line lag, as it is. Normal: sawtooth under 20 s. Over 300 s for 10 minutes warns (InkcastQueueHeadLagHigh).",
      "targets": [
        {
          "refId": "A",
          "expr": "max(inkcast_posts_oldest_due_age_seconds{namespace=\"$namespace\"})",
          "legendFormat": "oldest due",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#4e79a7"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 10
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      }
    },
    {
      "type": "row",
      "title": "Are publishes succeeding?",
      "collapsed": false,
      "panels": [],
      "id": 9,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      }
    },
    {
      "type": "timeseries",
      "title": "Publish outcomes (per second, stacked)",
      "description": "rate(inkcast_publish_total[5m]) by status, parts of a whole: published (green), failed (red), unconfirmed (orange), retry (yellow). Normal: all green. Any unconfirmed needs a person (InkcastUnconfirmedPublishes).",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(inkcast_publish_total{namespace=\"$namespace\", status=~\"published|draft|unlisted|updated\"}[5m]))",
          "legendFormat": "published",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(inkcast_publish_total{namespace=\"$namespace\", status=~\"failed|update_failed\"}[5m]))",
          "legendFormat": "failed",
          "range": true
        },
        {
          "refId": "C",
          "expr": "sum(rate(inkcast_publish_total{namespace=\"$namespace\", status=\"unconfirmed\"}[5m]))",
          "legendFormat": "unconfirmed",
          "range": true
        },
        {
          "refId": "D",
          "expr": "sum(rate(inkcast_publish_total{namespace=\"$namespace\", status=\"retry\"}[5m]))",
          "legendFormat": "retry",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 30,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#59a14f"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 30
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#e15759"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 30
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#f28e2b"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 30
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "D"
            },
            "properties": [
              {
