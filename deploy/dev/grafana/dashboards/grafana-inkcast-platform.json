                "value": {
                  "mode": "fixed",
                  "fixedColor": "#edc948"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 30
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      }
    },
    {
      "type": "timeseries",
      "title": "Publish call p95 (seconds)",
      "description": "histogram_quantile(0.95, inkcast_publish_duration_seconds) over [5m] by platform: one platform call. Normal: under 2 s. Near 30 s means timeouts, which end unconfirmed.",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(inkcast_publish_duration_seconds_bucket{namespace=\"$namespace\", platform=\"medium\"}[5m])))",
          "legendFormat": "medium",
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(inkcast_publish_duration_seconds_bucket{namespace=\"$namespace\", platform=\"devto\"}[5m])))",
          "legendFormat": "devto",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none"
            }
