    {
      "type": "stat",
      "title": "Publish success SLO: error ratio over 1 h",
      "description": "inkcast_slo:publish_success:error_ratio_1h (recording rule). The objective is 99%, so the budget is 1%: green under 1%, orange under 6x (burning), red above 14.4x (paging).",
      "targets": [
        {
          "refId": "A",
          "expr": "inkcast_slo:publish_success:error_ratio_1h",
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#bab0ac",
                "value": null
              },
              {
                "color": "#59a14f",
                "value": 0
              },
              {
                "color": "#f28e2b",
                "value": 0.01
              },
              {
                "color": "#e15759",
                "value": 0.144
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
