    {
      "type": "row",
      "title": "Is the API healthy?",
      "collapsed": false,
      "panels": [],
      "id": 14,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 43
      }
    },
    {
      "type": "timeseries",
      "title": "Requests by status class (per second, stacked)",
      "description": "rate(inkcast_http_request_duration_seconds_count[5m]) by code on API and MCP routes: 2xx green, 4xx orange, 5xx red. Probes are not counted. Normal: mostly green; 4xx are clients (401s from MCP discovery are expected).",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(inkcast_http_request_duration_seconds_count{namespace=\"$namespace\", code=\"2xx\", route=~\"/api/.*|/mcp\"}[5m]))",
          "legendFormat": "2xx",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(inkcast_http_request_duration_seconds_count{namespace=\"$namespace\", code=\"4xx\", route=~\"/api/.*|/mcp\"}[5m]))",
          "legendFormat": "4xx",
          "range": true
        },
        {
          "refId": "C",
          "expr": "sum(rate(inkcast_http_request_duration_seconds_count{namespace=\"$namespace\", code=\"5xx\", route=~\"/api/.*|/mcp\"}[5m]))",
          "legendFormat": "5xx",
          "range": true
        }
      ],
      "fieldConfig": {
