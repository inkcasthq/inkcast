    {
      "type": "stat",
      "title": "Schedule timeliness SLO: error ratio over 1 h",
      "description": "inkcast_slo:schedule_timeliness:error_ratio_1h. Objective 99%: the share of scheduled posts claimed later than 120 s. Green under 1%.",
      "targets": [
        {
          "refId": "A",
          "expr": "inkcast_slo:schedule_timeliness:error_ratio_1h",
          "legendFormat": "__auto",
          "range": true
